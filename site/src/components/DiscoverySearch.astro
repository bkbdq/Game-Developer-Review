---
import { projects } from '../lib/projects';
import { index, href, companyAliases } from '../lib/data';
const entries = [
  ...projects.map(p=>({name:p.name, info:p.company+' · '+p.count+' 篇评价', url:p.path, search:p.search, kind:'项目'})),
  ...index.companies.map(c=>({name:c.name,info:'全部 '+c.reviewCount+' 篇公司评价',url:href('company/'+c.slug+'/'),search:[c.name,c.slug,...companyAliases(c.id)].join(' ').normalize('NFKC').toLowerCase(),kind:'公司'})),
];
---
<div class="project-search" data-project-search>
  <div class="search-field"><i class="glass" aria-hidden="true"></i><input id="project-query" type="search" placeholder="搜索公司或项目" aria-label="搜索公司或项目" aria-controls="search-menu" autocomplete="off" /><button type="button" data-clear hidden aria-label="清空搜索">×</button></div>
  <div class="search-menu" id="search-menu" hidden>
    {entries.map(e=><a href={e.url} data-search={e.search} data-name={e.name} data-kind={e.kind}><span class="kind">{e.kind}</span><span><b>{e.name}</b><small>{e.info}</small></span><span class="search-go">↗</span></a>)}
    <span data-no-suggestions hidden>没有匹配的公司或项目</span>
  </div>
</div>
