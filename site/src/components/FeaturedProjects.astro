---
import { recentPicks, projects } from '../lib/projects';
import { href } from '../lib/data';
import ProjectCover from './ProjectCover.astro';
import CompanyRatingLink from './CompanyRatingLink.astro';
const slides = (recentPicks.length ? recentPicks : projects).slice(0,10);
const loops = slides.length > 1;
// Two cards at either end keep both previews visible while wrapping around.
const track = loops ? [...slides.slice(-2), ...slides, ...slides.slice(0,2)] : slides;
const start = loops ? 2 : 0;
const title = recentPicks.length ? '最近收到好评的项目' : '项目聚焦';
---
{slides.length>0 && <section class="featured" data-featured aria-label={title}>
  <div class="discovery-section-head"><h2><i aria-hidden="true"></i>{title}</h2>
    {loops && <div class="feature-nav"><button type="button" class="rotation" data-rotate aria-label="暂停自动轮播" title="暂停自动轮播">Ⅱ</button></div>}
  </div>
  <div class="feature-stage" data-loop={loops || undefined} role="group" aria-roledescription="轮播" aria-label={title}>
    <div class="feature-track" style={`--offset:${-start}`}>
    {track.map((p,i)=><article class="feature-slide" data-slide={i>=start && i<start+slides.length ? '' : undefined}
      inert={i!==start} aria-current={i===start ? 'true' : undefined}>
      <a class="hero-cover" href={p.path} aria-label={'查看'+p.name+'的全部评价'}><ProjectCover project={p} eager={i===start}/></a>
      <div class="feature-info">
        <CompanyRatingLink project={p}/>
        <h3><a href={p.path}>{p.name}</a></h3>
        <div class="feature-excerpts" aria-label="项目评价摘录">
          {p.featuredReview ? <blockquote><p>{p.featuredReview.comment}</p></blockquote> : <p>暂无公开评价</p>}
        </div>
        <div class="feature-bottom"><a class="review-cta" href={p.path}>查看全部评价 <b>→</b></a></div>
      </div>
      {loops && <img class="feature-preview-art" src={p.cover ?? href('images/studio.webp')} alt="" loading="lazy" decoding="async"/>}
    </article>)}
    </div>
    {loops && <>
      <button class="feature-side" type="button" data-prev aria-label={`上一个项目：${slides[slides.length-1].name}`}><span aria-hidden="true">‹</span></button>
      <button class="feature-side" type="button" data-next aria-label={`下一个项目：${slides[1].name}`}><span aria-hidden="true">›</span></button>
    </>}
  </div>
  {slides.length>1 && <div class="feature-dots" aria-label="切换精选项目">{slides.map((p,i)=><button type="button" aria-label={'精选项目：'+p.name} aria-current={i===0?'true':undefined} data-dot><i></i></button>)}</div>}
</section>}
