---
interface Props { slug?: string; src?: string; scale?: number; lazy?: boolean }
const { slug = 'brand', src, scale = 1, lazy = false } = Astro.props;
const glyphs: Record<string, string[]> = {
  brand: ['000000000000','000110011000','001111111100','011011110110','111001101111','111011110011','111111111111','111100001111','011000000110','000000000000'],
  cloudcape: ['0000000000','0000000100','0001000000','0011100100','0111111110','0110111110','1100011011','1111111111','0000000000','0000000000'],
  wovenfield: ['0000000000','0000000110','0001101110','0001111100','0110110000','0011110110','0001111100','0001100000','0011000000','0000000000'],
  glowharbor: ['0000110000','0001111000','0011111100','0001001000','0001111000','0000110000','0001111000','0001111000','0011111100','0111111110'],
  sandisle: ['0000000000','0000110000','0001111000','0011111100','0111001110','1110000111','0111001110','0011111100','0001111000','0000110000'],
  paperkite: ['0000010000','0000111000','0001111100','0011101110','0001101100','0000111000','0000010000','0000100000','0001100000','0010000000'],
  copperbell: ['0000110000','0001111000','0011111100','0011111100','0011111100','0111111110','1111111111','0000000000','0000110000','0000000000'],
  nightferry: ['0000010000','0000110000','0001110000','0011110000','0111110000','0000010000','1111111111','0111111110','0011111100','0000000000'],
  mossgear: ['0000110000','0111111110','0111111110','0011001100','1110000111','1110000111','0011001100','0111111110','0111111110','0000110000'],
  emberloom: ['0000010000','0000110000','0010111000','0011111010','0111111110','0111101110','1111001111','0110000110','0011001100','0001111000'],
  snowdial: ['0000110000','0100110010','0011111100','0001111000','1111111111','1111111111','0001111000','0011111100','0100110010','0000110000'],
};
const pattern = glyphs[slug] || glyphs.sandisle;
const dots = pattern.flatMap((row,y) => [...row].flatMap((bit,x) => bit === '1' ? [`${x}em ${y}em currentColor`] : []));
---
<span class:list={['mark', src ? 'mark-logo' : 'mark-' + (Object.hasOwn(glyphs,slug) ? slug : 'sandisle')]} aria-hidden="true">
  {src ? <img src={src} alt="" loading={lazy ? 'lazy' : 'eager'} decoding="async" style={{ transform: 'scale(' + scale + ')' }}/> : <i style={`width:${pattern[0].length}em;height:${pattern.length}em`}><b style={{boxShadow:dots.join(',')}}></b></i>}
</span>
