---
import { projectStatusLabel } from '../lib/projects';

interface Props { status: string }
const { status } = Astro.props;
const label = projectStatusLabel(status);
---
{label && <span class="project-status" data-status={status}>
  <span class="status-mark" aria-hidden="true">●</span>
  {label}
</span>}

<style>
  .project-status {
    display:inline-flex;
    align-items:center;
    gap:7px;
    min-height:32px;
    padding:4px 11px;
    border:1px solid currentColor;
    border-radius:5px;
    background:#344856;
    color:#d8e5ed;
    font-size:16px;
    font-weight:750;
    line-height:1.25;
    white-space:nowrap;
  }
  .status-mark { font-size:12px; line-height:1; }
  .project-status[data-status="dev"] { background:#463b26; color:#ffe0a0; border-color:#987e4e; }
  .project-status[data-status="cancelled"] { background:#493139; color:#f2c4c9; border-color:#96717c; }
</style>
