---
import Layout from '../components/Layout.astro';
import Mark from '../components/Mark.astro';
import ReviewRating from '../components/ReviewRating.astro';
import { minimumRatingCount } from '../lib/project-stats';
import { companyRatings, projectsByStudio } from '../lib/projects';
import { surveyUrl } from '../lib/survey';
import '../styles/studios.css';
import { href, index, detail, scoreText, month } from '../lib/data';
const sorted = index.companies.map(c => ({
  ...c, aliases: c.aliases ?? detail(c.id).company.aliases ?? [], titles: projectsByStudio.get(c.slug) ?? [],
  rating: companyRatings.get(c.id)!,
  mean: c.reviewCount ? Object.entries(c.scoreDistribution).reduce((sum,[score,count])=>sum + Number(score)*count,0) / c.reviewCount : -1,
})).sort((a,b) => b.rating.gradeRank-a.rating.gradeRank || b.reviewCount-a.reviewCount || a.name.localeCompare(b.name,'zh-CN'));
const updatedOrder = new Map([...sorted].sort((a,b)=>(b.lastPublishedAt ?? '').localeCompare(a.lastPublishedAt ?? ''))
  .map((company,i)=>[company.id,i]));
const mostReviewed = sorted.reduce<(typeof sorted)[number] | undefined>((best,c) =>
  c.reviewCount > (best?.reviewCount ?? 0) ? c : best, undefined);
const bestRated = sorted.filter(c=>c.rating.rated).sort((a,b)=>b.mean-a.mean || b.reviewCount-a.reviewCount)[0];
const awards = [
  { title: '评价最多', winner: mostReviewed, rule: '按累计评价篇数', empty: '暂无公开评价',
    cover: mostReviewed?.titles[0]?.thumb, metric: mostReviewed && mostReviewed.reviewCount+' 篇评价', detail: mostReviewed?.rating.grade },
  { title: '评价最好', winner: bestRated, rule: `至少 ${minimumRatingCount} 篇评价，按平均分`, empty: '暂无达标公司',
    cover: (bestRated === mostReviewed && bestRated?.titles[1]?.thumb) || bestRated?.titles[0]?.thumb,
    metric: bestRated && scoreText(bestRated.avgScore)+' / 5', detail: bestRated && bestRated.reviewCount+' 篇评价' },
];
---
<Layout title="公司目录" active="companies" dark>
  <header class="discovery-intro">
    <div><h1>公司目录</h1><p>{index.totals.companies} 家公司 <span>·</span> {index.totals.projects} 个游戏项目</p></div>
    <div class="search-field studio-search"><i class="glass" aria-hidden="true"></i><input type="search" id="query" aria-label="搜索公司" placeholder="搜索公司名称或别名" autocomplete="off" /><button type="button" id="clear-query" aria-label="清空搜索" hidden>×</button></div>
  </header>
  <section class="studio-awards" data-awards aria-label="公司榜首" hidden={!sorted.length}>
    {awards.map(({title,winner,rule,empty,cover,metric,detail})=><article class="studio-award">
      {cover && <img src={cover} alt="" decoding="async" />}
      <div class="award-content"><h2>{winner && <span class="award-rank" lang="en">No.1</span>}{title}</h2><small>{rule}</small>
        {winner ? <><a class="award-winner" href={href('company/'+winner.slug+'/')}><Mark slug={winner.slug}/><strong>{winner.name}</strong><span aria-hidden="true">↗</span></a>
          <p><b>{metric}</b> · {detail}</p></> : <p>{empty} · <a class="award-empty-link" href={surveyUrl()}>写评价</a></p>}
      </div>
    </article>)}
  </section>
  <section class="studio-directory" aria-labelledby="directory">
    <div class="discovery-section-head"><h2 id="directory"><i aria-hidden="true"></i><span data-list-title>全部公司</span><small data-count-label>{sorted.length}</small></h2>
      <label class="studio-sort">排序<select id="sort"><option value="grade">评价等级</option><option value="count">评价数量</option><option value="updated">最近更新</option></select></label>
    </div>
    <div class="studio-grid" id="companies">
      {sorted.map(c=><a class="company-card studio-tile" href={href('company/' + c.slug + '/')}
        data-name={[c.name,c.slug,...c.aliases].join(' ').normalize('NFKC').toLocaleLowerCase()} data-count={c.reviewCount} data-updated={updatedOrder.get(c.id)}>
        <div class="studio-tile-art">{c.titles[0]?.thumb && <img loading="lazy" decoding="async" src={c.titles[0].thumb} alt=""/>}
          <span class="studio-tile-score"><ReviewRating rating={c.rating}/></span>
        </div>
        <div class="studio-tile-body">
          <div class="studio-tile-name"><Mark slug={c.slug}/><div><h3>{c.name}</h3></div></div>
          <p class="studio-tile-numbers">{c.projectCount} 个项目 · {c.reviewCount} 篇评价 · 综合分 {scoreText(c.avgScore)}{c.avgScore!=null && ' / 5'}</p>
          <p class="studio-tile-updated">最近更新 {month(c.lastPublishedAt)}</p>
          <div class="studio-tile-foot"><div class="chips" aria-label="旗下项目">{c.titles.length ? c.titles.map(p=><span>{p.name}</span>) : <small>暂无收录项目</small>}</div><span aria-hidden="true">↗</span></div>
        </div>
      </a>)}
    </div>
    <p class="sr" role="status" id="results"></p>
    <div class="project-empty" id="no-results" hidden={sorted.length>0}>
      {sorted.length ? <>没有找到匹配的公司<div><button type="button" id="clear-search">查看全部</button></div></> :
        <>还没有公司数据<div><a class="review-cta" href={surveyUrl()}>去写第一条评价</a></div></>}
    </div>
  </section>
</Layout>
<script>
  const grid = document.querySelector<HTMLElement>('#companies')!;
  const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('.company-card'));
  const initialOrder = [...cards];
  const search = document.querySelector<HTMLInputElement>('#query')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const clearQuery = document.querySelector<HTMLButtonElement>('#clear-query')!;
  const countLabel = document.querySelector<HTMLElement>('[data-count-label]')!;
  const listTitle = document.querySelector<HTMLElement>('[data-list-title]')!;
  const awards = document.querySelector<HTMLElement>('[data-awards]')!;
  const noResults = document.querySelector<HTMLElement>('#no-results')!;
  const results = document.querySelector<HTMLElement>('#results')!;

  function applyVisibility() {
    const needle = search.value.trim().normalize('NFKC').toLocaleLowerCase();
    clearQuery.hidden = !search.value;
    let count = 0;
    for (const el of cards) {
      el.hidden = !el.dataset.name!.includes(needle);
      if (!el.hidden) count++;
    }
    countLabel.textContent = String(count);
    listTitle.textContent = needle ? '公司搜索结果' : '全部公司';
    awards.hidden = Boolean(needle) || cards.length===0;
    noResults.hidden = count > 0;
    results.textContent = `共 ${count} 家公司`;
  }

  function applySort() {
    const ordered = sort.value === 'grade' ? [...initialOrder] : [...cards];
    if (sort.value==='count') ordered.sort((a,b)=>Number(b.dataset.count)-Number(a.dataset.count));
    if (sort.value==='updated') ordered.sort((a,b)=>Number(a.dataset.updated)-Number(b.dataset.updated));
    for (const el of ordered) grid.append(el);
  }

  search.addEventListener('input', applyVisibility);
  sort.addEventListener('change', () => { applySort(); applyVisibility(); });
  function resetSearch() { search.value = ''; applyVisibility(); search.focus(); }
  clearQuery.addEventListener('click',resetSearch);
  document.querySelector('#clear-search')?.addEventListener('click',resetSearch);
  applyVisibility();
</script>
