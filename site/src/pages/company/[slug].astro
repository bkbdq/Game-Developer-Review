---
import Layout from '../../components/Layout.astro';
import StudioMasthead from '../../components/StudioMasthead.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import RatingDetails from '../../components/RatingDetails.astro';
import { companyRatings, projectsByStudio } from '../../lib/projects';
import { surveyUrl } from '../../lib/survey';
import '../../styles/studios.css';
import { detail, index, href, scoreText } from '../../lib/data';
export function getStaticPaths() {
  return index.companies.map(c => ({ params: { slug: c.slug }, props: { data: detail(c.id) } }));
}
const { company, projects, reviews } = Astro.props.data;
const ordered = [...reviews].sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt));
const rating = companyRatings.get(company.id)!;
const projectNames = new Map(projects.map(p=>[p.id,p.name]));
const writeUrl = surveyUrl(company.name);
const titles = projectsByStudio.get(company.slug) ?? [];
---
<Layout title={company.name} active="companies" company={company.name} dark>
  <nav class="studio-back" aria-label="返回导航"><a class="review-cta" href={href('companies/')}><span aria-hidden="true">←</span> 返回公司目录</a></nav>
  <StudioMasthead company={company}/>
  <section class="studio-rating-band" aria-label="公司评级">
    <RatingDetails rating={rating}/>
    <a class="review-cta" href={writeUrl}>评价这家公司 <span aria-hidden="true">→</span></a>
  </section>
  <nav class="studio-nav" aria-label="公司主页分区">
    <a href="#works">旗下项目 <small>{titles.length}</small></a><a href="#reviews">开发者评价 <small>{reviews.length}</small></a>{rating.rated && <a href="#ratings">评分概况</a>}
  </nav>
  <div class:list={['studio-layout',{'with-stats':rating.rated}]}>
    <div class="studio-main">
    <section id="works" aria-labelledby="works-title"><div class="discovery-section-head"><h2 id="works-title"><i aria-hidden="true"></i>旗下项目</h2></div>
      <div class="studio-projects">{titles.map(p=><ProjectTile project={p} inStudio/>)}</div>
      {titles.length===0 && <div class="project-empty">暂无收录项目<div><a href={writeUrl} class="review-cta">评价这家公司</a></div></div>}
    </section>
    <section id="reviews" class="project-reviews studio-reviews" aria-labelledby="reviews-title">
      <div class="discovery-section-head"><h2 id="reviews-title"><i aria-hidden="true"></i>开发者评价<small id="matches" aria-live="polite">{reviews.length}</small></h2></div>
      {rating.rated && <div class="filters"><label>项目<select id="project"><option value="">全部项目</option><option value="anonymous">匿名项目</option>{projects.map(p=><option value={p.id}>{p.name}</option>)}</select></label></div>}
      <div class="reviews">
        {ordered.map(r=>{
          const projectId = rating.rated && r.projectId && projectNames.has(r.projectId) ? r.projectId : undefined;
          return <ReviewCard review={r} showTenure={rating.rated}
            projectName={rating.rated ? (projectId ? projectNames.get(projectId) : '匿名项目') : undefined}
            projectFilter={rating.rated ? (projectId ?? 'anonymous') : undefined}/>;
        })}
      </div>
      <div class="project-empty" id="no-reviews" hidden={reviews.length>0}>
        {reviews.length>0 ? <>这个项目还没有公开评价<div><button id="reset" type="button">查看全部评价</button></div></> :
          <>暂无公开评价<div><a href={writeUrl} class="review-cta">成为第一个评价的人</a></div></>}
      </div>
    </section>
    </div>
    {rating.rated && <aside id="ratings" aria-labelledby="ratings-title" class="studio-insights">
      <div class="discovery-section-head"><h2 id="ratings-title"><i aria-hidden="true"></i>评分概况</h2></div>
      <section class="studio-stat"><h3>评分分布</h3><p class="studio-stat-average"><strong>{scoreText(company.avgScore)}</strong> / 5 <span>共 {company.reviewCount} 篇评价</span></p>
        {[5,4,3,2,1].map(n=><div class="bar-row"><span>{n} 星</span><div class="track"><i style={{width:(company.scoreDistribution[n] || 0)/company.reviewCount*100+'%'}}></i></div><b>{company.scoreDistribution[n] || 0}</b></div>)}
      </section>
    </aside>}
  </div>
</Layout>
<script>
  const selects = Array.from(document.querySelectorAll<HTMLSelectElement>('.filters select'));
  const reviews = Array.from(document.querySelectorAll<HTMLElement>('.review'));
  function applyFilters() {
    let count = 0;
    reviews.forEach(r => {
      r.hidden = selects.some(s => s.value && r.dataset[s.id] !== s.value);
      if (!r.hidden) count++;
    });
    document.querySelector('#matches')!.textContent = String(count);
    document.querySelector<HTMLElement>('#no-reviews')!.hidden = count > 0;
  }
  selects.forEach(s => s.addEventListener('change', applyFilters));
  document.querySelector('#reset')?.addEventListener('click', () => {
    selects.forEach(s => { s.value=''; }); applyFilters(); selects[0].focus();
  });
  applyFilters();
  const sections = document.querySelectorAll<HTMLAnchorElement>('.studio-nav a');
  function markSection() {
    const current = location.hash || '#works';
    sections.forEach(link=>{
      if (link.hash === current) link.setAttribute('aria-current','location');
      else link.removeAttribute('aria-current');
    });
  }
  window.addEventListener('hashchange',markSection);
  markSection();
</script>
